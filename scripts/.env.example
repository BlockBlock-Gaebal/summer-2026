# scripts/.env.example
#
# 이 파일을 .env로 복사해서 쓴다.  cp .env.example .env
# .env는 gitignore 대상이다. 절대 커밋하지 말 것.
#
# 값의 정본은 docs/DEPLOYMENT.md 다 (D-20).
# 카톡·개인 메모의 ID는 사본이며, 다르면 DEPLOYMENT.md가 맞다.

# --- 네트워크 ---
# mainnet | testnet | devnet | localnet
SUI_NETWORK=testnet

# ⚠️ 공개 풀노드의 JSON-RPC는 폐지되었다 (2026-08 기준 전 메서드 Method not found).
#    따라서 @mysten/sui의 SuiClient(JSON-RPC)가 아니라 SuiGrpcClient(gRPC-web)를 쓴다.
#    이 값은 gRPC-web 엔드포인트다. 비워두면 SUI_NETWORK 기준 기본값을 쓴다.
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443

# --- 배포 좌표 (docs/DEPLOYMENT.md) ---
PACKAGE_ID=0x11615c35e5bda13cb1f86c17b076e8ec025fcb0008fdf68ddc9ab0c290612e60

# 조회 대상 Challenge (shared object).
# ⚠️ 0xfb1eb049655a716a4270e977f948f02da07bfb60736acf7fe1dc08a66c78c6b7 은
#    참가자 0명인 빈 방이다. submit_results를 호출하면 전멸로 판정되어
#    영구히 ENDED로 잠기므로 쓰기 스크립트로 건드리지 말 것.
CHALLENGE_ID=

# 참가자 Table ID. 비워두면 read_state가 Challenge에서 자동으로 찾아낸다.
# (participants 필드의 id — 굳이 손으로 넣지 않아도 된다)
PARTICIPANTS_TABLE_ID=

# 오라클 주소 (submit_results 호출 권한자 = 방 생성자)
ORACLE_ADDRESS=0x982fcf2d322d579917cd45a3ec2903460d52fddd5deb74f2c4ecfa86d5dedb65

# --- 쓰기 스크립트용 (seed.ts / submit.ts) ---
# ⚠️ 개인키. .env에만 넣고 절대 커밋하지 말 것.
# `sui keytool export --key-identity <alias>` 로 얻는 suiprivkey1... 형식.
# 읽기 전용인 read_state.ts는 이 값이 없어도 동작한다.
ORACLE_PRIVATE_KEY=
